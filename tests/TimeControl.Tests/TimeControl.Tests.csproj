<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The pure core is compiled straight in, so the tests need none of the game or BepInEx assemblies. -->
  <ItemGroup>
    <Compile Include="..\..\src\TimeControl\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The page scripts run in Jint against a fake of the game's web UI. -->
  <ItemGroup>
    <EmbeddedResource Include="FakePage.js" LogicalName="TimeControl.Tests.FakePage.js" />
  </ItemGroup>

  <!-- The injected MonoBehaviour's source is read as text to check which methods the game is given. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\TimeControl\Adapters\ClockTicker*.cs" LogicalName="TimeControl.Tests.Ticker.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
